# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_poc
POSTGRES_PORT=5432

# Database Connection URLs
# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/doc_poc
# Sync URL for Alembic migrations (psycopg2)
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/doc_poc

# Gemini API Key (Required for LLM features, checked in health check)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend / Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

