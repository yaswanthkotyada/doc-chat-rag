# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_poc
POSTGRES_PORT=5432

# Database Connection URLs
# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/doc_poc
# Sync URL for Alembic migrations (psycopg2)
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/doc_poc

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Chat Behavior Settings
HISTORY_MAX_MESSAGES=30
MAX_MESSAGE_CHARS=4000

# Document Upload & Storage Settings (Stage 3)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50
MAX_FILES_PER_CONVERSATION=10
MAX_FILES_PER_REQUEST=5
INGEST_FAKE_DELAY_SECONDS=0

# Direct Mode Settings (Stage 4)
DIRECT_MAX_PAGES=40
DIRECT_MAX_MB=20
DIRECT_MAX_TOTAL_TOKENS=300000
GEMINI_FILE_UPLOAD_TIMEOUT_SECONDS=30
CSV_MAX_ROWS_DIRECT=200

# Docling Parsing Settings (Stage 5)
DOCLING_IMAGE_TAG=ghcr.io/docling-project/docling-serve-cpu:latest
DOCLING_PORT=5001
DOCLING_URL=http://docling:5001
DOCLING_MEM_LIMIT=3500M
PARSE_MODE=rag_only
PARSE_BATCH_PAGES=10
PARSE_CONCURRENCY=1
PARSE_TIMEOUT_SECONDS=300
PARSE_OCR_ENABLED=true
PARSE_MIN_CHARS_PER_PAGE=50

# Stage 6 Chunking & Embedding Settings
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=80
CHUNK_MIN_TOKENS=60
EMBED_MODEL=gemini-embedding-001
EMBED_BATCH_SIZE=100
EMBED_DIMENSIONS=768
EMBED_CONCURRENCY=2

# Stage 7 RAG Chat & Agent Settings
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_RETRIEVED_TOKENS=30000
AGENT_TIMEOUT_SECONDS=60
SEARCH_RESULT_MAX_CHARS=1800
SEARCH_MAX_TOP_K=10
HISTORY_INCLUDE_TOOL_RESULTS=false

# Frontend / Web Configuration
VITE_API_URL=http://localhost:8000
